{
  "bsonType": "object",
  "required": ["name", "type", "icon", "sortOrder"],
  "permission": {
    "read": true,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "name": { "bsonType": "string", "description": "分类名" },
    "type": {
      "bsonType": "string",
      "description": "分类类型",
      "enum": ["expense", "income"]
    },
    "icon": { "bsonType": "string", "description": "图标名（对应 Icon 组件的 name 属性）" },
    "sortOrder": { "bsonType": "int", "description": "排序序号" }
  }
}
